node_modules/
apps/web/dist/
apps/api/data/
apps/api/clearledger
apps/api/clearledger.exe
__pycache__/
*.pyc
*.log

# Legacy paths: keep until every feature branch has moved to apps/ (then delete).
web/dist/
backend/data/
backend/clearledger
backend/clearledger.exe
