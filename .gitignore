# Keep local documentation and environment files out of the repository.
*.[mM][dD]
!.github/pull_request_template.md
.env*
*.env
*.env.*
coordination/
docs/*
!docs/architecture.mmd

# Local agent files (skills, CLAUDE.md, AGENTS.md copies) stay on this machine.
.github/skills/
.github/claude/
